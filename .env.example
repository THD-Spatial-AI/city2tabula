# This is an EXAMPLE .env file for basic configuration for City2TABULA.
# Copy this file as .env and place in root directory of this project and DO NOT FORGET to update the values as needed.

####################
## Country select ##
####################

# Specify the country you want to train from the list of 'available countries' below
COUNTRY=germany

# Available countries
#
# 1.  austria
# 2.  belgium
# 3.  bulgaria
# 4.  cyprus
# 5.  czechia
# 6.  denmark
# 7.  france
# 8.  germany
# 9.  greece
# 10. hungary
# 11. ireland
# 12. italy
# 13. netherlands
# 14. norway
# 15. poland
# 16. serbia
# 17. slovenia
# 18. spain
# 19. sweden
# 20. united_kingdom

# Note: These countries are available based on the TABULA and EPISCOPE project data. Therefore running pipeline on other countries is not supported.

############################
## Database Configuration ##
############################

# PyLovo schema containing the res and oth building tables.
# Set this to the schema where pylovo.res and pylovo.oth live in your database.
# Required only when running -link-pylovo. Ignored when PYLOVO_FDW_HOST is set
# (FDW mode always imports the foreign tables into schema "pylovo").
PYLOVO_SCHEMA=public

# PyLovo FDW: the central PyLovo database that -link-pylovo federates to via
# postgres_fdw. Each country has its own City2TABULA database, so pylovo.res/oth
# cannot be a local join; leave PYLOVO_FDW_HOST empty to keep the local-table
# behaviour above. When set, -link-pylovo (re)creates the foreign server, a user
# mapping for the connecting role, and schema "pylovo" holding the foreign
# res/oth tables. The role in PYLOVO_FDW_USER only needs SELECT on res and oth.
PYLOVO_FDW_HOST=
PYLOVO_FDW_PORT=5432
PYLOVO_FDW_DBNAME=
PYLOVO_FDW_USER=
PYLOVO_FDW_PASSWORD=

# Grid cell side length in metres for spatial batching during -link-pylovo.
# Each 1 km × 1 km cell becomes one job; buildings within a cell are spatially
# co-located, so the PyLovo bounding-box pre-filter eliminates most rows before
# the IoU join runs. Smaller values = tighter pre-filter, more jobs.
PYLOVO_LINK_GRID_SIZE=1000

# Base name for the pipeline's database. The tool appends the country's ISO
# 3166-1 alpha-2 code and creates the database if it does not exist, so
# DB_NAME=city2tabula with COUNTRY=netherlands uses "city2tabula_nl". An
# existing database is only picked up if its name already carries the suffix.
DB_NAME=<your_db_name_here>
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<your_pg_password_here>

# 'enable' it for production
DB_SSL_MODE=disable

##########################
## CityDB Configuration ##
##########################

# Path to your citydb-tool install. Not needed in Docker — the image bakes
# this in (see environment/Dockerfile). Only bare-metal/local dev needs to
# set it, since there's no fixed path to know.
CITYDB_TOOL_PATH=<path/to/citydb-tool-1.X.X>

# CITYDB_SRID/CITYDB_SRS_NAME are derived automatically from COUNTRY above
# (see internal/config/srid.go for the full table). Set them here only to
# override the derived value, e.g. for a country not in that table.
#CITYDB_SRID=25832
#CITYDB_SRS_NAME=ETRS89 / UTM zone 32N

#########################
## Resource constrains ##
#########################
THREAD_COUNT=4

###########################
## Logging Configuration ##
###########################
LOG_LEVEL=INFO
# Set the logging level (DEBUG, INFO, WARN, ERROR)
# For development: DEBUG - shows all debug information
# For production: INFO - shows essential information only
# For monitoring: WARN - shows only warnings and errors

###################################
## Testing / Development Limits  ##
###################################

# Import limit caps features pulled from GML files by the citydb-tool in citydb Useful for creating a small test DB without importing the full dataset. Does not affect subsequent feature extraction runs on an already-imported DB.
#
# e.g. 1000  (0 or empty = import everything)
IMPORT_LIMIT=0

# Building limit caps how many buildings the City2TABULA extraction pipeline processes. Set this to debug or benchmark against a subset of an already-imported DB. Independent of IMPORT_LIMIT, the DB can hold 50k buildings while you only process 100 of them.
#
# e.g. 100   (0 or empty = process all buildings in the 3DCityDB schema)
BUILDING_LIMIT=0

# Validation limit caps matched validation pairs per category (buildings, roof surfaces, wall surfaces, floor surfaces). The load functions JOIN directly with City2TABULA tables and apply LIMIT at the DB level, so validation continues until N matches are found or the full dataset is exhausted. Sampling is random (ORDER BY RANDOM() in SQL).
#
# e.g. 10000  (0 or empty = validate all available matches)
VALIDATION_LIMIT=0

# Define maximum 2D distance in metres between building footprints for two buildings to be considered neighbours. Accounts for small gaps in CityGML data between adjacent buildings.
NEIGHBOUR_TOLERANCE=0.5

# Define the default room height in metres for buildings without a defined height in the CityGML data. This is used to generate 3D building models for buildings with missing height information.
ROOM_HEIGHT=3