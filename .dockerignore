# Host-specific env file — the Docker image gets its config from
# environment/http/docker.env via docker-compose's env_file directive
.env

# Git and editor metadata
.git
.github
.vscode

# Build artefacts / logs / generated docs — not needed inside the image
city2tabula
city2tabula-*
bin/
build/
*.out
coverage.*
*.coverprofile
*.log
logs/
site/

# The 3D source datasets are gitignored, large, and mounted at runtime via the
# compose volume. data/tabula is tracked repo content the pipeline reads with
# psql \copy, so it is baked in and the server image needs no host mount.
data/lod2/
data/lod3/
testdata/

# Validation research outputs: gitignored, regenerated by running the pipeline,
# and absent from a fresh clone. Without this, COPY bakes whatever the person
# building happened to have produced into the image, so two builds of the same
# commit differ by gigabytes.
validation/

# Local / scratch directories
