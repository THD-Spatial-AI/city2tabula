# Runtime image carrying both entry points: the on-request HTTP server
# (cmd/server) and the CLI (cmd/c2t).
#
# environment/Dockerfile is the development toolchain image: it carries the Go
# and Java toolchains and the whole source tree so `make dev` can build and run
# anything interactively. This one carries a compiled binary and only what the
# pipeline shells out to at runtime.
#
# Kept out deliberately: the Go toolchain (the binary is built in the first
# stage and is static, CGO_ENABLED=0), the Go source, and the geospatial C
# libraries, which nothing links against once cgo is off.
#
# Kept in, because the pipeline cannot run without them: a Java runtime and
# citydb-tool, which creates the 3DCityDB schema and imports and exports
# CityGML/CityJSON; and psql, which loads the TABULA CSVs via \copy.

ARG GO_VERSION=1.25.0
ARG CITYDB_TOOL_VERSION=1.3.2
ARG JAVA_VERSION=25

FROM golang:${GO_VERSION}-bookworm AS build
ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Stamps internal/version, the same values .github/workflows/release.yml sets
# on the CLI binaries, so a published image reports the release it came from.
#
# Both binaries: the server runs bbox-scoped pipeline runs on request, and c2t
# runs the same pipeline from the command line, so the image needs no extra
# runtime to serve as a one-shot pipeline job as well as the API.
RUN MOD_PATH="$(awk '/^module /{print $2}' go.mod)" \
    && LDFLAGS="-s -w \
         -X ${MOD_PATH}/internal/version.Version=${VERSION} \
         -X ${MOD_PATH}/internal/version.Commit=${COMMIT} \
         -X ${MOD_PATH}/internal/version.Date=${DATE}" \
    && CGO_ENABLED=0 go build -trimpath -ldflags "$LDFLAGS" -o /out/city2tabula-server ./cmd/server \
    && CGO_ENABLED=0 go build -trimpath -ldflags "$LDFLAGS" -o /out/c2t ./cmd/c2t

FROM debian:bookworm-slim AS citydb
ARG CITYDB_TOOL_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget unzip \
    && rm -rf /var/lib/apt/lists/*
RUN wget -q https://github.com/3dcitydb/citydb-tool/releases/download/v${CITYDB_TOOL_VERSION}/citydb-tool-${CITYDB_TOOL_VERSION}.zip -O /tmp/citydb-tool.zip \
    && unzip -q /tmp/citydb-tool.zip -d /usr/local/citydb-tool \
    && rm /tmp/citydb-tool.zip

FROM eclipse-temurin:${JAVA_VERSION}-jre
ARG CITYDB_TOOL_VERSION

# wget is the compose healthcheck's probe, not a build tool.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=citydb /usr/local/citydb-tool /usr/local/citydb-tool
# Known path inside the image, as in environment/Dockerfile: docker.env never
# needs to set this.
ENV CITYDB_TOOL_PATH="/usr/local/citydb-tool/citydb-tool-${CITYDB_TOOL_VERSION}"

# config.SQLDir and config.DataDir are relative ("sql/", "data/"), resolved
# against the working directory, so the layout here has to mirror the
# repository root rather than being arbitrary.
WORKDIR /app
COPY sql/ ./sql/
COPY data/ ./data/
COPY --from=build /out/city2tabula-server ./city2tabula-server
COPY --from=build /out/c2t ./c2t

RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000
CMD ["./city2tabula-server"]
