# Global Configuration

COUNTRY=germany


# Available countries:

# austria
# belgium
# cyprus
# czechia
# denmark
# france
# germany
# greece
# hungary
# ireland
# italy
# netherlands
# norway
# poland
# serbia
# slovenia
# spain
# sweden
# united_kingdom

# Note: These countries are available based on the TABULA and EPISCOPE project data. Therefore running pipeline on other countries is not supported.


# Application port mapping (host port -> container 8080)
# Change this if 8080 collides with another service
HOST_PORT=5000

# Database connection settings (Connect to host PostgreSQL)
DB_NAME=city2tabula_test
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable # enable it for production

# CityDB Configuration
#
# CITYDB_TOOL_PATH is baked into the image (see environment/Dockerfile) — do
# not set it here, it would override the correct in-image path with a stale
# one. CITYDB_SRID/CITYDB_SRS_NAME are derived automatically from COUNTRY
# above; set them here only to override the derived value for a country not
# in that lookup table (see internal/config/srid.go).



# Parallel Processing Configuration
THREAD_COUNT=4        # Number of threads for parallel processing (optional)

# Logging Configuration
LOG_LEVEL=INFO # Set the logging level (DEBUG, INFO, WARN, ERROR)
               # For development: DEBUG - shows all debug information
               # For production: INFO - shows essential information only
               # For monitoring: WARN - shows only warnings and errors